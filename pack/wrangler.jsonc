{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rantlib-pack",
  "compatibility_date": "2026-10-08",
  "routes": [{ "pattern": "pack.rantlib.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "node build.mjs pack", "watch_dir": ["page.html", "pages.mjs", "database.mjs", "src", "../src", "../public/logo.svg"] },
  "assets": {
    "directory": "../dist-pack",
    "not_found_handling": "404-page"
  }
}
