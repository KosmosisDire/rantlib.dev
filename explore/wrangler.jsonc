{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rantlib-explore",
  "compatibility_date": "2026-10-08",
  "routes": [{ "pattern": "explore.rantlib.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "node build.mjs explore", "watch_dir": ["page.mjs"] },
  "assets": {
    "directory": "../dist-explore"
  }
}
