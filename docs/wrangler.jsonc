{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rantlib-docs",
  "compatibility_date": "2026-10-08",
  "routes": [{ "pattern": "docs.rantlib.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "node build.mjs docs", "watch_dir": ["docs", "src"] },
  "assets": {
    "directory": "../dist-docs",
    "not_found_handling": "404-page"
  }
}
