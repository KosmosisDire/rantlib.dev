{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rantlib-dev",
  "compatibility_date": "2026-10-08",
  "routes": [{ "pattern": "rantlib.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "node build.mjs site",
    "watch_dir": ["src", "public"]
  },
  "assets": {
    "directory": "./dist"
  }
}
